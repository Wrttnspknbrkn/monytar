# SpendWell Environment Variables
# Copy this to .env.local and fill in your values

# --- Supabase (External) ---
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Stripe (External) ---
# Get these from your Stripe dashboard: Developers > API Keys
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
# Webhook secret (for subscription events) - optional for initial setup
# Get this from: Stripe Dashboard > Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mode Behavior ---
# When Supabase env vars are NOT set, the app runs in demo mode
# with mock data. No additional configuration needed.
#
# When Stripe env vars are NOT set, checkout pages show a
# configuration message. The rest of the app works normally.
